{
  "output": [
    "DP-2",
    "eDP-1",
    "HDMI-A-1"
  ],
  "layer": "top",
  "position": "top",
  "height": 0,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces"
    // "custom/lock",
    // "custom/reboot",
    // "custom/power",
    // "custom/temperature",
    // "disk",
    // "memory",
    // "cpu",
    // "backlight"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    // "hyprland/window",
    "tray",
    // "network",
    // "bluetooth",
    // "pulseaudio",
    "battery"
  ],
  "hyprland/window": {
    "format": "{class}",
    "rewrite": {
      "": "Arch Linux"
    }
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "on-click": "activate",
    "format": "{name}"
    // "format-icons": {
    //   "1": "○",
    //   "2": "○",
    //   "3": "○",
    //   "4": "○",
    //   "5": "○",
    //   "active": "●",
    //   "default": ""
    // }
  },
  "network": {
    "format-wifi": "<span color='#FAF9F6'>󰤨</span>",
    "format-ethernet": "<span color='#FAF9F6'>󰈀</span>",
    "format-linked": "<span color='#FAF9F6'></span>",
    "format-disconnected": "<span color='#FAF9F6'>󱘖</span>",
    "interval": 5,
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>",
    "on-click": "iwmenu -l custom --launcher-command 'wofi --show dmenu'"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#FAF9F6'>{icon}</span>",
    "format-charging": "󱐋",
    "interval": 1,
    "format-icons": [
      "󰂎",
      "󰁼",
      "󰁿",
      "󰂁",
      "󰁹"
    ],
    "tooltip": true
  },
  "pulseaudio": {
    "format": "<span color='#FAF9F6'>{icon}</span>",
    "format-muted": "<span color='#FAF9F6'>󰖁</span>",
    "format-icons": {
      "headphone": "<span color='#FAF9F6'></span>",
      "hands-free": "<span color='#FAF9F6'></span>",
      "headset": "<span color='#FAF9F6'></span>",
      "phone": "<span color='#FAF9F6'></span>",
      "portable": "<span color='#FAF9F6'></span>",
      "car": "<span color='#FFA500'></span>",
      "default": [
        "<span color='#FAF9F6'></span>",
        "<span color='#FAF9F6'></span>",
        "<span color='#FAF9F6'></span>"
      ]
    },
    "on-click-right": "pavucontrol",
    "on-click": "pactl -- set-sink-mute 0 toggle",
    "tooltip": true,
    "tooltip-format": "device: {desc}\nvolume: {volume}%"
  },
  "custom/temperature": {
    "exec": "sensors | awk '/^Package id 0:/ {print int($4)}'",
    "format": "<span color='#FFA500'>  </span>{}°C ",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "CPU: {}°C"
  },
  "disk": {
    "path": "/",
    "interval": 20,
    "format": "<span color='#d6175d'>  </span>{percentage_free}% ",
    "tooltip": true,
    "tooltip-format": "used: {used} - {percentage_used}%\n\nfree: {free} - {percentage_free}%"
  },
  "memory": {
    "format": "<span color='#8A2BE2'>  </span>{percentage}% ",
    "tooltip": true,
    "tooltip-format": "{used:0.2f}G/{total:0.2f}G",
    "on-click": "btop++"
  },
  "cpu": {
    "format": "<span color='#FF9F0A'>  </span>{usage}% ",
    "tooltip": true
  },
  "clock": {
    "format": "{:%a %d, %H:%M}",
    "interval": 60,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ffcc66'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 4
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "<span color='#FFD700'>{icon}</span>{percent}% ",
    "tooltip": true,
    "tooltip-format": "{percent}%",
    "format-icons": [
      "<span color='#696969'> 󰃞 </span>",
      "<span color='#A9A9A9'> 󰃝 </span>",
      "<span color='#FFFF66'> 󰃟 </span>",
      "<span color='#FFD700'> 󰃠 </span>"
    ]
  },
  "bluetooth": {
    "format": "<span color='#808080'></span>",
    "format-connected": "<span color='#50C878'></span>",
    "format-connected-battery": "<span color='#00BFFF'></span>",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "bzmenu -l custom --launcher-command 'wofi --show dmenu'"
  }
}
